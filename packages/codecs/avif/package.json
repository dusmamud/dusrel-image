{
  "name": "@dusrel/image-avif",
  "version": "1.0.1",
  "description": "libavif + libaom codec (WASM, lazy-loaded). Default speed 9; threaded build opt-in only.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./codec/*": "./codec/*"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "codec"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dusmamud/dusrel-image.git",
    "directory": "packages/codecs/avif"
  }
}
