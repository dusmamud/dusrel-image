{
  "name": "@dusrel/image-svelte",
  "version": "0.0.0",
  "description": "Thin Svelte wrapper over @dusrel/image and @dusrel/image-crop.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./DusrelCrop.svelte": {
      "types": "./dist/DusrelCrop.svelte.d.ts",
      "svelte": "./dist/DusrelCrop.svelte",
      "default": "./dist/DusrelCrop.svelte"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/compile-fixture.mjs && tsdown && node scripts/copy-svelte.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dusmamud/dusrel-image.git",
    "directory": "packages/frameworks/svelte"
  },
  "dependencies": {
    "@dusrel/image": "workspace:*",
    "@dusrel/image-crop": "workspace:*"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "svelte": "^5.0.0"
  },
  "svelte": "./dist/index.js"
}
